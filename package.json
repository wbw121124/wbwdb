{
	"name": "@wbw121124/wbwdb",
	"version": "1.0.0",
	"description": "A new database lib by wbw121124",
	"type": "module",
	"main": "./lib/index.js",
	"author": {
		"name": "wbw121124"
	},
	"license": "GPLv3.0-only",
	"private": false,
	"dependencies": {
		"@typescript/native": "npm:typescript@^7.0.2",
		"bcrypt": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"uuid": "^14.0.1",
		"wbw-cli-tools-lib": "^1.0.0"
	},
	"bin": {
		"wbwdb": "./bin/wbwdb-cli.js"
	},
	"files": [
		"./bin/*",
		"./lib/*"
	],
	"typings": "./lib/index.d.ts",
	"scripts": {
		"build": "rolldown -c",
		"build:watch": "rolldown -c --watch",
		"clean": "rm -rf lib",
		"lint": "eslint src/",
		"doc": "rimraf docs && typedoc",
		"dev": "npm run doc && npm run build && npm run test",
		"test": "node --experimental-strip-types test/demo.ts && node --experimental-strip-types test/auth-demo.ts && node test/cli-test.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bcrypt": "^6.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.1.1",
		"eslint": "^10.8.0",
		"rimraf": "^6.1.3",
		"rolldown": "^1.2.0",
		"rolldown-plugin-dts": "^0.27.14",
		"typedoc": "^0.28.20",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.65.0"
	},
	"allowScripts": {
		"bcrypt@6.0.0": true
	}
}