{
	"name": "wbwdb",
	"version": "1.0.0",
	"description": "A new database lib by wbw121124",
	"type": "module",
	"main": "./lib/index.js",
	"author": {
		"name": "wbw121124"
	},
	"license": "GPLv3.0-only",
	"private": false,
	"dependencies": {
		"tslint": "^6.1.3",
		"typescript": "^6.0.2",
		"uuid": "^14.0.1"
	},
	"files": [
		"./bin/*",
		"./lib/*"
	],
	"typings": "./lib/index.d.ts",
	"scripts": {
		"build": "rolldown -c",
		"build:watch": "rolldown -c --watch",
		"clean": "rm -rf lib",
		"lint": "tslint -c tslint.json src/**/*.ts",
		"doc": "rimraf docs && typedoc",
		"dev": "npm run doc && npm run build && npm run test",
		"test": "node --experimental-strip-types test/demo.ts"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/uuid": "^10.0.0",
		"rolldown": "^1.2.0",
		"rolldown-plugin-dts": "^0.27.12",
		"typedoc": "^0.28.20",
		"rimraf": "^6.1.3"
	}
}